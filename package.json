{
  "name": "barba-and-co",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "next dev -p 3000",
    "dev:server": "tsx watch server/src/index.ts",
    "dev": "concurrently -n \"NEXT,EXPRESS\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:server\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "server": "tsx server/src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "firebase:sync": "tsx scripts/sync-firebase.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.186.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "firebase": "^13.1.0",
    "framer-motion": "^14.6.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "next": "14.2.15",
    "postprocessing": "^6.39.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "three": "^0.186.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
